{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AI": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(make)",
      "Bash(make *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git shortlog*)",
      "Bash(git describe*)",
      "Bash(git grep *)",
      "Bash(git reflog)",
      "Bash(git reflog show*)",
      "Bash(git branch)",
      "Bash(git branch -a*)",
      "Bash(git branch -r*)",
      "Bash(git branch -v*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --contains *)",
      "Bash(git tag -l*)",
      "Bash(git tag --list*)",
      "Bash(git for-each-ref*)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git name-rev *)",
      "Bash(git cat-file *)",
      "Bash(git diff-tree *)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git check-ignore *)",
      "Bash(git worktree list*)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git config --get *)",
      "Bash(git config --list*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore --staged *)",
      "Bash(git stash)",
      "Bash(git stash push*)",
      "Bash(git stash list*)",
      "Bash(git stash show*)",
      "Bash(git stash pop*)",
      "Bash(git stash apply*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.p12)",
      "Read(config/jwt/**)",
      "Read(config/secrets/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(auth.json)",
      "Read(.mcp.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cat .mcp.json)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(docker exec * env)",
      "Bash(docker-compose exec * env)"
    ]
  }
}
